LINKUP_API_KEY=your-linkup-key
ANTHROPIC_API_KEY=your-anthropic-key
# Model used for extraction + judging. Swap freely.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = faster/cheaper)
LLM_EFFORT=medium
# Server-side refusal fallback ("default" or empty to disable; disable if your model doesn't support it)
LLM_FALLBACKS=default
